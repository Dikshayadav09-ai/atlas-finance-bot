# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Groq API key from https://console.groq.com (free tier, no credit card needed)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alpha Vantage API key from https://www.alphavantage.co/support/#api-key (free tier)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# SQLite database file (no setup needed, created automatically)
DATABASE_URL=sqlite:///./atlas.db

# Timezone for scheduling daily briefs (e.g. Asia/Kolkata, America/New_York)
TIMEZONE=Asia/Kolkata

# Default time for daily morning brief (24hr format, HH:MM)
DEFAULT_BRIEF_TIME=08:00
